{
  "name": "three-oh-four",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "304 — the Sri Lankan trick-taking card game. Casino-table web app, pass-and-play, built to grow into Bluetooth and online multiplayer.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
